# Free tier, no credit card required — sign up at console.groq.com to get a key.
# This is tried first for the AI Gateway. Without it (and without
# NVIDIA_API_KEY below), /chat falls back to seeded legal-info snippets and
# /analyze falls back to regex-based clause risk flagging only — nothing
# errors, both features just run in a reduced, non-AI mode.
GROQ_API_KEY=

# Optional fallback — NVIDIA NIM (free tier, OpenAI-compatible endpoint).
# Sign up at build.nvidia.com to get a key. Only used when GROQ_API_KEY is
# not set.
NVIDIA_API_KEY=

# Turso (libSQL/SQLite, hosted) — optional. Sign up free at turso.tech,
# create a database, and copy its URL + auth token here. Without these,
# sessions/chat history/analysis history fall back to an in-memory store
# (per-process, via lib/global-store.ts) instead of a real database. No
# manual schema step needed — tables are created automatically on first use.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Signs the session-id cookie (HMAC-SHA256). Required for sessions to verify
# consistently across multiple serverless instances in production — without
# it, a random per-instance secret is used (fine for local dev only).
SESSION_SECRET=

# Login gate — env-based credentials, no database. Format:
# "username1:password1,username2:password2" (comma-separated pairs, colon
# splits each one). Leave unset and the app stays fully open (no login at
# all) — the zero-config default. Set this to require login for every page
# and API route.
#
# IMPORTANT: also set SESSION_SECRET above when you set this. The login
# route (Node runtime) and the auth check (Edge middleware) are separate JS
# runtimes that don't share memory — without a shared SESSION_SECRET, each
# one signs with its own random secret and login will appear to succeed but
# then immediately bounce you back to /login. If APP_USERS is set without
# SESSION_SECRET, the app deliberately stays OPEN (fails safe) and logs a
# warning, rather than shipping that broken state.
#
# Username must be a well-formed email address (validated with zod's
# .email()) — e.g. APP_USERS=demo@example.com:your-password-here
APP_USERS=
